# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ

# สมองของ Ciel: "ollama" (ใช้งานจริง) หรือ "mock" (ทดสอบหน้า UI โดยไม่ต้องมีโมเดล)
CIEL_LLM=ollama
OLLAMA_URL=http://127.0.0.1:11434
CIEL_MODEL=qwen3:8b

# ปิดโหมด "คิดก่อนตอบ" ของ Qwen3 ให้ตอบเร็วขึ้น (true/false)
CIEL_THINK=false
# สร้าง prompt แบบ Qwen3 (ChatML) เองแล้วเรียก /api/generate แบบ raw เพื่อให้ prompt cache ใช้ได้ทุกข้อ
# ตั้ง false เพื่อกลับไปใช้ /api/chat (เช่น โมเดลที่ไม่ใช่ตระกูล Qwen)
CIEL_RAW_PROMPT=true
# true เมื่อใช้โมเดลที่ fine-tune จาก training/ แล้ว (เช่น CIEL_MODEL=ciel-qwen3):
# ใช้ system prompt สั้นแบบที่เทรนมา (~700 token) และไม่ใส่ตัวอย่างบทสนทนา (prompt เต็ม ~6,600 token)
CIEL_TUNED=false
CIEL_TEMPERATURE=0.7
CIEL_NUM_CTX=8192

# ให้ Ollama ถือโมเดลไว้ใน RAM นานแค่ไหน (-1 = ตลอด, หรือเช่น 30m) — ปล่อยแล้วข้อความถัดไปช้าขึ้น ~35 วินาที
CIEL_KEEP_ALIVE=-1
# จำนวน token สูงสุดต่อคำตอบ (กันโมเดลพูดวนไม่หยุด)
CIEL_NUM_PREDICT=150

# จำนวนข้อความย้อนหลังที่ส่งให้โมเดล (ยิ่งมากยิ่งจำได้นาน แต่ช้าลงและกิน RAM)
CIEL_MAX_HISTORY=20

# ไฟล์นิสัยของ Ciel (แก้แล้วมีผลทันทีตอนเริ่มแชทใหม่ ไม่ต้องรีสตาร์ท)
CIEL_PERSONA=persona/ciel.yaml

# เสียงพูด: "edge" (Edge TTS, ต้องต่ออินเทอร์เน็ต) หรือ "off"
CIEL_TTS=edge

# 127.0.0.1 = เข้าได้จากเครื่องนี้ + Tailscale serve, 0.0.0.0 = เปิดให้ทั้งวง Wi-Fi
CIEL_HOST=127.0.0.1
CIEL_PORT=47080

# รหัสผ่านหน้าเว็บ (เว้นว่าง = ไม่ต้องล็อกอิน) แนะนำให้ตั้งถ้าเปิดใช้จากเครื่องอื่น
CIEL_PASSWORD=

# อัปเดตอัตโนมัติจาก GitHub (เปิดเฉพาะบนเครื่องเซิร์ฟเวอร์ ไม่ต้องเปิดบนเครื่องที่ใช้พัฒนา)
# แก้ web/ หรือ persona/ → มีผลทันที, แก้โค้ด Python → Ciel รีสตาร์ทตัวเอง
CIEL_AUTO_UPDATE=false
CIEL_UPDATE_BRANCH=main
CIEL_UPDATE_INTERVAL=60
